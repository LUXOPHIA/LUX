unit LUX.Process.Deadline;

// このプロセスの、終わりの期限。
//
//【使いどころ】
// ・終わりの手順を始めるときに、期限を仕掛ける。手順のどこか（主スレッド・止まりきらない部品）が詰まっても、
//   期限が来たら、プロセスを終わらせる（終わらないプロセスを、残さない。次の起動と、資源を奪い合わせない）。
//
//【作り】
// ・期限を待つのは、専用の実行スレッド。主スレッドが詰まっていても、効く。
// ・期限の前に、プロセスがふつうに終われば、待っている実行スレッドは、プロセスと一緒に消える
//   （この実行スレッドだけは、持ち主より長く生きるのが役目なので、終わりを待たない）。
// ・期限が来たら、片付けをせずに、その場で終わらせる（TerminateProcess）。片付けは、もう、詰まっている。

interface //#################################################################### ■

type //$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$【 T Y P E 】

     //$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$【 R E C O R D 】

     //%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% TProcessDeadline

     // このプロセスの、終わりの期限。状態を持たない手続きの集まり。
     TProcessDeadline = record
     private
     public
       ///// M E T H O D
       // いまから Ms_ ミリ秒たっても、このプロセスが動いていたら、終了コード Code_ で、終わらせる
       class procedure Arm( const Ms_,Code_:Cardinal ); static;
     end;

     //$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$【 C L A S S 】

//$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$【 R O U T I N E 】

implementation //############################################################### ■

uses Winapi.Windows,
     System.Classes;

//$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$【 R E C O R D 】

//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% TProcessDeadline

//&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&&& public

//////////////////////////////////////////////////////////////////// M E T H O D

class procedure TProcessDeadline.Arm( const Ms_,Code_:Cardinal );
var
   M, C :Cardinal;
begin
     M := Ms_;
     C := Code_;

     TThread.CreateAnonymousThread( procedure
                                    begin
                                         Sleep( M );

                                         TerminateProcess( GetCurrentProcess, C );
                                    end ).Start;
end;

//$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$【 C L A S S 】

//$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$【 R O U T I N E 】

end. //######################################################################### ■
